{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@iam/(.*)$": "<rootDir>/src/iam/$1",
    "^@common/(.*)$": "<rootDir>/src/common/$1",
    "^@users/(.*)$": "<rootDir>/src/users/$1",
    "^@complains/(.*)$": "<rootDir>/src/complains/$1",
    "^@notifications/(.*)$": "<rootDir>/src/notifications/$1",
    "^@lov/(.*)$": "<rootDir>/src/lov/$1",
    "^@localities/(.*)$": "<rootDir>/src/localities/$1",
    "^@quotations/(.*)$": "<rootDir>/src/quotations/$1",
    "^@trackings/(.*)$": "<rootDir>/src/trackings/$1",
    "^@contact-us/(.*)$": "<rootDir>/src/contact-us/$1"
  }
}
