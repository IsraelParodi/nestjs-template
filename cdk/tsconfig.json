{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "paths": {
      "@lambda/*": ["../src/lambda/*"],
      "@common/*": ["../src/common/*"],
      "@iam/*": ["../src/iam/*"],
      "@users/*": ["../src/users/*"],
      "@quotations/*": ["../src/quotations/*"],
      "@contact-us/*": ["../src/contact-us/*"],
      "@complains/*": ["../src/complains/*"],
      "@localities/*": ["../src/localities/*"],
      "@lov/*": ["../src/lov/*"],
      "@notifications/*": ["../src/notifications/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
