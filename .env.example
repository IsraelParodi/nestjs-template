# Environment Variables Example
# Copy this file to .env.production and fill in actual values

# Application
APP_ENV=PROD

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_TOKEN_AUDIENCE=your-app-audience
JWT_TOKEN_ISSUER=your-app-issuer
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# Database (RDS will be provided by CDK)
DB_TYPE=postgres
DATABASE_HOST=nestjs-template-db.xxxxx.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your-secure-password
DATABASE_NAME=nestjs_db

# SendGrid (Email Service)
SENDGRID_API_KEY=SG.your-sendgrid-key-here

# Twilio (SMS Service)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AWS Configuration (Usually handled by IAM roles in Lambda)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=not-needed-in-lambda
# AWS_SECRET_ACCESS_KEY=not-needed-in-lambda

# Optional: Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Optional: CORS
CORS_ORIGIN=https://yourfrontend.com

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
